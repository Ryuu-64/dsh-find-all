{
  "name": "@ryuu-64/dsh-find-all",
  "version": "0.1.4",
  "description": "Ctrl+F find bar for the DSH desktop app: it searches the whole conversation, not just the messages already on screen.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "author": "Ryuu-64",
  "contributors": [
    "secyborg (upstream dsh-find-bar, MIT)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryuu-64/dsh-find-all.git"
  },
  "homepage": "https://github.com/Ryuu-64/dsh-find-all#readme",
  "bugs": {
    "url": "https://github.com/Ryuu-64/dsh-find-all/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.2.0-0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check:registration": "node scripts/check-client-registration.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && npm run check:registration && node --test \"test/**/*.test.mjs\"",
    "verify:release": "node scripts/verify-release.mjs",
    "install:local": "node scripts/install-local.mjs",
    "deploy:profile": "node scripts/deploy-profile.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "find",
    "search",
    "conversation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.2": "compatible"
      }
    }
  }
}
